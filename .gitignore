# =============================================================================
# .gitignore — Racik Media V3
# =============================================================================

# --- Environment Variables ----------------------------------------------------
# JANGAN pernah commit file .env ke repository
.env
**/.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# --- Credentials & Secrets ----------------------------------------------------
apps/api/src/credentials/
credentials/
*.pem
*.p12
*.key
*.cert

# --- Dependencies -------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# --- Build Output -------------------------------------------------------------
dist/
build/
.next/
out/
apps/api/dist/
apps/web/.next/
apps/web/out/

# --- TypeScript ---------------------------------------------------------------
*.tsbuildinfo
apps/web/tsconfig.tsbuildinfo

# --- Logs ---------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test & Coverage ----------------------------------------------------------
coverage/
.nyc_output/

# --- OS & Editor --------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~

# --- Docker -------------------------------------------------------------------
docker-compose.override.yml

# --- Supabase Local -----------------------------------------------------------
.supabase/

# --- Folder kerja sementara & data dump ---------------------------------------
apps/api/data env campur/
docs/data-env-campur/
file tambahan backup data/
*.zip
*.json.bak
*.txt.bak
apps/api/.env new.txt
apps/api/data env.txt
