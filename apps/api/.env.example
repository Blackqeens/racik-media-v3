# ============================================================
# .env.example — Racik Media V3 · API Server Template
# JANGAN isi file ini dengan secret/key produksi!
# Copy file ini ke .env lalu masukkan credentials Anda.
# ============================================================

# ─── App ────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME=Racik Media V3
APP_VERSION=1.0.0

# ─── API Server ─────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database (PostgreSQL via Supabase Pooler) ──────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ─── JWT (internal NestJS token) ────────────────────────────
JWT_SECRET=your_long_random_jwt_secret_at_least_32_chars_here
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=7d

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=600

# ─── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=racik_v3
RABBITMQ_DLX=racik.dlx

# ─── Meilisearch ────────────────────────────────────────────
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=your_meilisearch_master_key_here

# ─── WhatsApp ───────────────────────────────────────────────
WHATSAPP_GATEWAY_URL=https://graph.facebook.com
WHATSAPP_API_TOKEN=your_whatsapp_token_here

# ─── Email (Resend) ──────────────────────────────────────────
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=re_placeholder_key_here
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# ─── Push Notifications (Firebase FCM) ──────────────────────
PUSH_API_URL=https://fcm.googleapis.com/v1/projects/your-project-id/messages:send
PUSH_API_KEY=AIzaSyPlaceholderKeyHere
PUSH_CLIENT_EMAIL=app-backend@your-project-id.iam.gserviceaccount.com
GOOGLE_CLOUD_PROJECT_ID=your-project-id

# ─── Payment Gateway ─────────────────────────────────────────
PAYMENT_GATEWAY=midtrans
PAYMENT_AML_THRESHOLD=100000000
MIDTRANS_SERVER_KEY=Mid-server-placeholder-here
MIDTRANS_CLIENT_KEY=Mid-client-placeholder-here
MIDTRANS_IS_PRODUCTION=false

# ─── Logistics ───────────────────────────────────────────────
LOGISTICS_PROVIDER=biteship
BITESHIP_API_KEY=your_biteship_api_key_here
BITESHIP_WEBHOOK_SECRET=your_biteship_webhook_secret_here

# ─── Storage Buckets ─────────────────────────────────────────
STORAGE_BUCKET_PUBLIC=public-assets
STORAGE_BUCKET_KYC=kyc-documents
STORAGE_BUCKET_KYB=kyb-documents
STORAGE_BUCKET_CHAT=chat-attachments
STORAGE_BUCKET_INVOICES=invoices
STORAGE_BUCKET_CONTRACTS=contracts
STORAGE_BUCKET_DELIVERABLES=deliverables

# ─── Tenant ──────────────────────────────────────────────────
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
